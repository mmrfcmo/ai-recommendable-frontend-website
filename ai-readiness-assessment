<script>
function toggleMobileMenu(){var m=document.getElementById('mobile-menu');m.classList.toggle('hidden');if(!m.classList.contains('hidden')){setTimeout(function(){m.classList.add('hidden');},3000);}}

function validateAndShowLeadForm(){
  var allSelected=true;
  for(var i=1;i<=7;i++){if(!document.querySelector('input[name="facet'+i+'"]:checked')){allSelected=false;break;}}
  if(!allSelected){alert('Please select a score for all 7 areas before calculating.');return;}
  document.getElementById('lead-overlay').style.display='flex';
}

function submitLeadAndShowScore(){
  var name=document.getElementById('lead-name').value.trim();
  var company=document.getElementById('lead-company').value.trim();
  var email=document.getElementById('lead-email').value.trim();
  var phone=document.getElementById('lead-phone').value.trim();
  var website=document.getElementById('lead-website').value.trim();
  if(!name||!company||!email||!phone){alert('Please fill in all required fields.');return;}
  document.getElementById('lead-overlay').style.display='none';
  calculateScoreInternal(name,company,email,phone,website);
}

function calculateScoreInternal(name,company,email,phone,website){
  var total=0;var facets=[];
  var facetNames=['AI Strategy','People & Skills','Processes & Automation','Data Readiness','Technology','Governance & Risk','Leadership & Culture'];
  for(var i=1;i<=7;i++){var s=document.querySelector('input[name="facet'+i+'"]:checked');if(s){facets.push(Math.round(parseFloat(s.value)));total+=parseFloat(s.value);}}
  var score=Math.round(total);var level='',msg='',color='';
  if(score<=21){level='AI Beginner';color='#ef4444';msg='Your business is at the beginning of its AI journey.'}
  else if(score<=35){level='AI Aware';color='#f97316';msg='You have some awareness of AI but lack structure.'}
  else if(score<=49){level='AI Developing';color='#eab308';msg='You\'re making progress but have gaps holding you back.'}
  else if(score<=63){level='AI Advanced';color='#22c55e';msg='Your business is well-positioned for AI adoption.'}
  else{level='AI Leader';color='#06b6d4';msg='Your business is ahead of most.'}
  var bd='';
  for(var i=0;i<7;i++){var bc=facets[i]>=7?'#22c55e':facets[i]>=4?'#eab308':'#ef4444';bd+='<div class="flex items-center gap-3 mb-2"><span class="text-xs text-zinc-400 w-32 shrink-0">'+facetNames[i]+'</span><div class="flex-1 h-2 rounded-full bg-zinc-700"><div class="h-2 rounded-full" style="width:'+(facets[i]*10)+'%;background-color:'+bc+'"></div></div><span class="text-xs text-zinc-400 w-6">'+facets[i]+'/10</span></div>';}
  var r='<div id="score-result" class="mt-8 p-6 rounded-2xl border" style="border-color:'+color+'40;background:linear-gradient(135deg,rgba(0,0,0,0.5),rgba(0,0,0,0.3))"><div class="text-center mb-6"><div class="text-5xl font-extrabold mb-1" style="color:'+color+'">'+score+'<span class="text-2xl text-zinc-500">/70</span></div><div class="text-lg font-semibold" style="color:'+color+'">'+level+'</div><p class="text-sm text-zinc-400 mt-3">'+msg+'</p></div><div class="border-t border-zinc-700 pt-4 mt-4"><p class="text-xs text-zinc-500 font-semibold uppercase tracking-wider mb-3">Facet Breakdown</p>'+bd+'</div><div class="mt-6 text-center"><p class="text-sm text-zinc-400 mb-3">Want to discuss your results?</p><a href="https://social.prospectrocket.com/AR/AIVisibilityReviewMeeting" class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-5 py-3 text-sm font-bold text-zinc-900 shadow-sm transition hover:bg-amber-400">Book Your Free Review Call →</a></div></div>';
  var ex=document.getElementById('score-result');if(ex)ex.remove();
  var q=document.getElementById('assessment-questions');
  if(q){q.insertAdjacentHTML('afterend',r);}
  var sr=document.getElementById('score-result');if(sr){sr.scrollIntoView({behavior:'smooth',block:'center'});}
  var fd=new FormData();
  fd.append('_subject','AI Readiness Assessment Lead');
  fd.append('_replyto','mmr1979@hotmail.co.uk');
  fd.append('Lead - Name',name);
  fd.append('Lead - Company',company);
  fd.append('Lead - Email',email);
  fd.append('Lead - Phone',phone);
  fd.append('Lead - Website',website);
  fd.append('Overall Score',score+'/70');
  fd.append('Level',level);
  for(var i=0;i<7;i++){fd.append('Facet - '+facetNames[i],facets[i]+'/10');}
  fetch('https://formspree.io/f/mqpzqkdl',{method:'POST',body:fd,headers:{'Accept':'application/json'}}).catch(function(){});
}

